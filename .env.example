# Safe defaults for local development only. Copy to .env to override Compose.
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
GATEWAY_PORT=8000
TRADING_LOG_LEVEL=INFO
TRADING_JWT_SECRET=development-only-change-me-32chars
TRADING_JWT_ISSUER=trading-platform
TRADING_JWT_AUDIENCE=trading-platform-api
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Local processes use these values; Compose supplies container-network URLs.
TRADING_ENVIRONMENT=development
TRADING_DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading
TRADING_REDIS_URL=redis://localhost:6379/0
TRADING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRADING_MARKET_DATA_URL=http://localhost:8001
TRADING_ORDERS_URL=http://localhost:8002
TRADING_PORTFOLIO_URL=http://localhost:8003

# Production must set environment=production and replace every credential.
# Use a randomly generated JWT secret of at least 32 characters and managed
# PostgreSQL, Redis, and Kafka endpoints; never deploy the defaults above.
